# Postgres (Coolify VPS)
DATABASE_URL=

# Cloudflare R2 (S3-compatible)
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
# Public custom domain in front of the R2 bucket. Audio is served from here
# directly, never proxied through Next (R2 egress is free, Range is supported).
R2_PUBLIC_URL=

# Payload, generate with: openssl rand -base64 32
PAYLOAD_SECRET=

# Resend (contact form delivery), domain andy-cinquin.com is verified
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Cloudflare Turnstile (contact form anti-bot).
# Cloudflare's published test keys are in .env for local work and the test suite:
#   1x00000000000000000000AA / 1x0000000000000000000000000000000AA  always passes
#   2x00000000000000000000AB / 2x0000000000000000000000000000000AA  always blocks
# Real keys are still needed before launch.
TURNSTILE_SITE_KEY=
# Same value, exposed to the browser. NEXT_PUBLIC_* is inlined at build time,
# so Coolify must mark it build-enabled.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# `log` writes contact messages to the log instead of sending them. Anything else
# sends through Resend. Local development and the e2e suite use `log`.
CONTACT_DELIVERY=
