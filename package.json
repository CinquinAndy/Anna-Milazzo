{
	"name": "anna-milazzo",
	"version": "0.1.0",
	"private": true,
	"description": "Portfolio of Anna Milazzo \u2014 Italian at /, English at /en.",
	"type": "module",
	"packageManager": "bun@1.3.14",
	"engines": {
		"node": ">=20.9.0"
	},
	"scripts": {
		"dev": "NODE_OPTIONS=--no-deprecation next dev",
		"devsafe": "rm -rf .next && NODE_OPTIONS=--no-deprecation next dev",
		"build": "NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
		"start": "NODE_OPTIONS=--no-deprecation next start",
		"lint": "biome ci .",
		"check": "biome check --write .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"validate": "bun run lint && bun run typecheck && bun run test && bun run build && bun run test:e2e",
		"payload": "NODE_OPTIONS=\"--no-deprecation --no-experimental-strip-types\" payload",
		"migrate": "bun run payload migrate",
		"migrate:create": "bun run payload migrate:create",
		"migrate:status": "bun run payload migrate:status",
		"generate:types": "bun run payload generate:types",
		"generate:importmap": "bun run payload generate:importmap"
	},
	"dependencies": {
		"@payloadcms/db-postgres": "3.88.0",
		"@payloadcms/next": "3.88.0",
		"@payloadcms/richtext-lexical": "3.88.0",
		"@payloadcms/ui": "3.88.0",
		"graphql": "16.14.2",
		"next": "16.3.4",
		"payload": "3.88.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"sharp": "0.34.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@playwright/test": "1.62.1",
		"@tailwindcss/postcss": "4.3.3",
		"@types/node": "24.13.3",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.7",
		"dotenv": "16.6.1",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"vitest": "4.1.11"
	}
}
